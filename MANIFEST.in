include CHANGELOG.md
include README.md
include LICENSE

include src/pgpack_dumper/common/queries/*.sql
include src/pgpack_dumper/common/*.pyi
include src/pgpack_dumper/common/*.pyd
recursive-include src/pgpack_dumper *.sql
recursive-include src/pgpack_dumper *.pyi
recursive-include src/pgpack_dumper *.pyd

exclude src/pgpack_dumper/common/*.c
recursive-exclude src/pgpack_dumper *.c

exclude *.c
exclude src/*.c
exclude src/**/*.c
global-exclude *.c
